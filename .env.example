# Public URL of your deployed app (used to build the six QR URLs). No trailing slash.
PUBLIC_APP_URL=https://your-domain.com

# Port the Node server listens on (most hosts inject this automatically)
PORT=3000

# Password for the single admin account
ADMIN_PASSWORD=change-me-now

# Random long string used to sign admin session tokens and team session cookies
SESSION_SECRET=change-this-to-a-long-random-string

# Path to the SQLite database file (mount a persistent volume at this path in production)
DATABASE_PATH=./data/game.db
